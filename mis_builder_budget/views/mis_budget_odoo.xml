<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_report_budget_form_analytic" model="ir.ui.view">
        <field name="name">account.report.budget.form.analytic</field>
        <field name="model">account.report.budget</field>
        <field name="inherit_id" ref="account_reports.account_report_budget_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='item_ids']/list/field[@name='account_id']" position="after">
                <field name="analytic_account_id" width="30%"/>
            </xpath>
        </field>
    </record>
</odoo>
